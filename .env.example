NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
WORKER_TOKEN=
STORE_CURRENCY=INR
STORE_TAX_BPS=1800
PRICING_VERSION=sample-2026-01
# Enable only after the commercial terms, shipping, tax and rates are approved.
COMMERCE_ENABLED=false
# Comma-separated ISO country codes served by the business.
SHIPPING_COUNTRIES=IN

BUSINESS_NAME=Digital Heroes
# Test placeholder only. Never enable statutory invoicing with this value.
BUSINESS_GSTIN=TEST-NOT-VALID

# SMTP sender (Gmail with a dedicated app password, or another SMTP provider)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Display name plus a verified sender, e.g. Digital Heroes <sender@example.com>
# EMAIL_FROM=

# Optional public contact on privacy/terms pages; use a business support address.
SUPPORT_EMAIL=
